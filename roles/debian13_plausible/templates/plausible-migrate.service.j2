[Unit]
Description=Migrate the imported Plausible databases
After=postgresql@17-main.service clickhouse-server.service
Requires=postgresql@17-main.service clickhouse-server.service
[Service]
Type=oneshot
User=plausible
Group=plausible
WorkingDirectory=/opt/plausible/current
EnvironmentFile=/etc/plausible/plausible.env
ExecStart=/opt/plausible/current/bin/plausible eval Plausible.Release.interweave_migrate()
TimeoutStartSec=900
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
