{% for key, value in vault_plausible_environment | dictsort %}
{% if key not in ['BASE_URL', 'DATABASE_URL', 'CLICKHOUSE_DATABASE_URL', 'HTTP_PORT', 'LISTEN_IP', 'RELEASE_DISTRIBUTION', 'DEFAULT_DATA_DIR', 'TMPDIR', 'APP_VERSION'] %}
{{ key }}={{ value | to_json }}
{% endif %}
{% endfor %}
BASE_URL="https://{{ hetzner_domains.plausible }}"
DATABASE_URL="postgres://plausible:{{ vault_plausible_postgres_password }}@127.0.0.1:5432/{{ debian13_plausible_database }}"
CLICKHOUSE_DATABASE_URL="http://plausible:{{ vault_plausible_clickhouse_password }}@127.0.0.1:8123/{{ debian13_plausible_clickhouse_database }}"
HTTP_PORT={{ debian13_plausible_port }}
LISTEN_IP="127.0.0.1"
DEFAULT_DATA_DIR="/var/lib/plausible"
TMPDIR="/var/lib/plausible/tmp"
RELEASE_DISTRIBUTION="none"
ERL_FLAGS="+S 4:4"
APP_VERSION="{{ debian13_plausible_version }}"
