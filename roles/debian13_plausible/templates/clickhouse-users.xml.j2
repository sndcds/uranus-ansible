<clickhouse>
  <profiles><plausible><max_memory_usage>2147483648</max_memory_usage><max_threads>4</max_threads></plausible></profiles>
  <users>
    <default>
      <password_sha256_hex remove="1"/>
      <password replace="replace"></password>
      <networks replace="replace"><ip>127.0.0.1</ip><ip>::1</ip></networks>
    </default>
    <plausible>
      <password_sha256_hex>{{ vault_plausible_clickhouse_password | hash('sha256') }}</password_sha256_hex>
      <networks><ip>127.0.0.1</ip><ip>::1</ip></networks>
      <profile>plausible</profile><quota>default</quota>
    </plausible>
  </users>
</clickhouse>
