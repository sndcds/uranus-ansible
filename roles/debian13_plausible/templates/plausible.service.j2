[Unit]
Description=Plausible Community Edition (native)
After=network-online.target postgresql@17-main.service clickhouse-server.service
Requires=postgresql@17-main.service clickhouse-server.service
[Service]
User=plausible
Group=plausible
WorkingDirectory=/opt/plausible/current
EnvironmentFile=/etc/plausible/plausible.env
ExecStart=/opt/plausible/current/bin/plausible start
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
LimitNOFILE=65535
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
[Install]
WantedBy=multi-user.target
