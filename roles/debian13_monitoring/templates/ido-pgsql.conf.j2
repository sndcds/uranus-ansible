object IdoPgsqlConnection "ido-pgsql" {
  user = "{{ monitoring_ido_db_user }}"
  password = "{{ monitoring_ido_db_password }}"
  host = "{{ hostvars[monitoring_db_delegate_host].ansible_host | default(monitoring_db_delegate_host) }}"
  port = 5432
  ssl_mode = "verify-full"
  ssl_ca = "/etc/ssl/certs/uranus-ca.pem"
  database = "{{ monitoring_ido_db_name }}"
}
