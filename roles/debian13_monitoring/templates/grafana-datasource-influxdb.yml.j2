apiVersion: 1

datasources:
  - name: {{ monitoring_grafana_datasource_name }}
    uid: {{ monitoring_grafana_datasource_uid }}
    type: influxdb
    access: proxy
    url: https://{{ ansible_host }}:8086
    database: {{ monitoring_influx_database }}
    isDefault: true
    editable: false
    jsonData:
      tlsAuthWithCACert: true
      httpMode: GET
      version: InfluxQL

    secureJsonData:
      tlsCACert: {{ lookup('file', uranus_pki_dir ~ '/ca.crt') | to_json }}
