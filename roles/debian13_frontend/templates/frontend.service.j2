[Unit]
Description=Uranus Nuxt frontend
After=network-online.target uranus-backend.service
Wants=network-online.target

[Service]
Type=simple
User=uranus
Group=uranus
WorkingDirectory=/opt/uranus/frontend/current
EnvironmentFile=/etc/uranus/frontend.env
ExecStart=/usr/bin/node /opt/uranus/frontend/current/server/index.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0027

[Install]
WantedBy=multi-user.target
