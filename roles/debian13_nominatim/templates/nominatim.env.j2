NOMINATIM_DATABASE_DSN=pgsql:host={{ hostvars[nominatim_db_delegate_host].ansible_host | default(nominatim_db_delegate_host) }};port={{ debian13_nominatim_db_port }};sslmode=verify-full;sslrootcert=/etc/ssl/certs/uranus-ca.pem;dbname={{ nominatim_db_name }};user={{ nominatim_db_user }};password={{ nominatim_db_password }}
NOMINATIM_DATABASE_WEBUSER={{ nominatim_db_user }}
NOMINATIM_IMPORT_STYLE={{ nominatim_import_style }}
NOMINATIM_DEFAULT_LANGUAGE={{ nominatim_default_language }}
NOMINATIM_LANGUAGES={{ nominatim_languages | join(',') }}
{% if nominatim_flatnode_file | default('') %}
NOMINATIM_FLATNODE_FILE={{ nominatim_flatnode_file }}
{% endif %}
{% if debian13_nominatim_replication_url | default('') %}
NOMINATIM_REPLICATION_URL={{ debian13_nominatim_replication_url }}
NOMINATIM_REPLICATION_UPDATE_INTERVAL={{ debian13_nominatim_replication_interval }}
NOMINATIM_REPLICATION_RECHECK_INTERVAL={{ debian13_nominatim_replication_recheck }}
{% endif %}
