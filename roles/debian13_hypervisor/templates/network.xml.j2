<network>
  <name>{{ hetzner_network_name }}</name>
  <forward mode='nat'/>
  <bridge name='{{ hetzner_bridge }}' stp='on' delay='0'/>
  <domain name='uranus.internal' localOnly='yes'/>
  <ip address='{{ hetzner_gateway }}' netmask='255.255.255.0'>
    <dhcp>
{% for vm in hetzner_vms %}
      <host mac='{{ vm.mac }}' name='{{ vm.name }}' ip='{{ vm.ip }}'/>
{% endfor %}
    </dhcp>
  </ip>
</network>
