#cloud-config
hostname: {{ item.name }}
manage_etc_hosts: true
disable_root: true
ssh_pwauth: false
users:
  - name: debian
    shell: /bin/bash
    groups: [adm, sudo]
    sudo: 'ALL=(ALL) NOPASSWD:ALL'
    lock_passwd: true
    ssh_authorized_keys:
      - {{ lookup('file', hetzner_ssh_public_key_file) | to_json }}
package_update: true
packages: [qemu-guest-agent, python3, sudo, acl]
runcmd:
  - [systemctl, enable, --now, qemu-guest-agent]
