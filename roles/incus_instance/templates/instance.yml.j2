config:
  user.uranus.owner: uranus/incus/v1
  user.uranus.disk_gib: "{{ incus_instance.disk }}"
  limits.cpu: "{{ incus_instance.cpu }}"
  limits.memory: "{{ incus_instance.memory }}MiB"
  boot.autostart: "true"
  security.protection.delete: "true"
{% if incus_instance.type == 'container' %}
  security.privileged: "false"
  security.nesting: "false"
  security.idmap.isolated: "true"
{% endif %}
  user.network-config: |
    version: 2
    renderer: networkd
    ethernets:
      "e*":
        dhcp4: true
        dhcp6: false
        accept-ra: false
  user.user-data: |
    #cloud-config
    hostname: {{ incus_instance.name }}
    manage_etc_hosts: true
    disable_root: true
    ssh_pwauth: false
    users:
      - name: debian
        shell: /bin/bash
        groups: [adm, sudo]
        sudo: 'ALL=(ALL) NOPASSWD:ALL'
        lock_passwd: true
        ssh_authorized_keys:
          - {{ lookup('file', hetzner_ssh_public_key_file) | to_json }}
    # Incus configures MAC-based DHCP and installs the shared baseline after boot.
    package_update: false
    package_upgrade: false
profiles: []
devices:
  root:
    type: disk
    path: /
    pool: uranus
{% if incus_instance.type == 'virtual-machine' or incus_container_quotas %}
    size: {{ incus_instance.disk }}GiB
{% endif %}
  eth0:
    type: nic
    name: eth0
    network: uranusincus0
    ipv4.address: {{ incus_instance.ip }}
    security.mac_filtering: "true"
    security.ipv4_filtering: "true"
    security.ipv6_filtering: "true"
{% if incus_instance.role | default('') == 'ingress' %}
{% for name, port in [('http', 80), ('https', 443)] %}
  {{ name }}:
    type: proxy
    bind: host
    nat: "false"
    listen: "tcp:[::]:{{ port }}"
    connect: "tcp:127.0.0.1:{{ port }}"
    proxy_protocol: "true"
{% endfor %}
{% endif %}
